n              href={data.meta.github}\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"btn btn-outline\"\n            >\n              GitHub\n            </a>\n            <a\n              href={data.meta.linkedin}\n              target=\"_blank\"\n              rel=\"noreferrer\"\n              className=\"btn btn-outline\"\n            >\n              LinkedIn\n            </a>\n          </div>\n        </div>\n      </section>\n\n      {/* About */}\n      <section className=\"section\" id=\"about\">\n        <div className=\"container\">\n          <h2 className=\"section-title\">About</h2>\n          <p className=\"about-bio\">{data.bio}</p>\n          <p className=\"about-location\">\n            <span className=\"location-dot\" /> {data.meta.location}\n          </p>\n        </div>\n      </section>\n\n      {/* Skills */}\n      <section className=\"section section--alt\" id=\"skills\">\n        <div className=\"container\">\n          <h2 className=\"section-title\">Skills</h2>\n          <div className=\"skills-grid\">\n            {data.skills.map((group, i) => (\n              <div className=\"skill-group\" key={i}>\n                <h3 className=\"skill-category\">{group.category}</h3>\n                <div className=\"skill-tags\">\n                  {group.items.map((item, j) => (\n                    <span className=\"tag\" key={j}>\n                      {item}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Experience */}\n      <section className=\"section\" id=\"experience\">\n        <div className=\"container\">\n          <h2 className=\"section-title\">Experience</h2>\n          <div className=\"timeline\">\n            {data.experience.map((job, i) => (\n              <div className=\"timeline-item\" key={i}>\n                <div className=\"timeline-header\">\n                  <div>\n                    <h3 className=\"job-role\">{job.role}</h3>\n                    <p className=\"job-company\">\n                      {job.company} &mdash; {job.location}\n                    </p>\n                  </div>\n                  <span className=\"job-period\">{job.period}</span>\n                </div>\n                <ul className=\"job-highlights\">\n                  {job.highlights.map((h, j) => (\n                    <li key={j}>{h}</li>\n                  ))}\n                </ul>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Projects */}\n      <section className=\"section section--alt\" id=\"projects\">\n        <div className=\"container\">\n          <h2 className=\"section-title\">Projects</h2>\n          <div className=\"projects-grid\">\n            {data.projects.map((project, i) => (\n              <div className=\"project-card\" key={i}>\n                <div className=\"project-header\">\n                  <h3 className=\"project-name\">{project.name}</h3>\n                  <span className=\"project-subtitle\">{project.subtitle}</span>\n                </div>\n                <p className=\"project-description\">{project.description}</p>\n                <div className=\"project-tech\">\n                  {project.tech.map((t, j) => (\n                    <span className=\"tag tag-small\" key={j}>\n                      {t}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Education */}\n      <section className=\"section\" id=\"education\">\n        <div className=\"container\">\n          <h2 className=\"section-title\">Education</h2>\n          <div className=\"education-card\">\n            <div className=\"education-header\">\n              <div>\n                <h3 className=\"edu-degree\">{data.education.degree}</h3>\n                <p className=\"edu-institution\">{data.education.institution}</p>\n              </div>\n              <div className=\"edu-right\">\n                <span className=\"job-period\">{data.education.period}</span>\n                <span className=\"edu-gpa\">GPA {data.education.gpa}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Contact */}\n      <section className=\"section section--alt\" id=\"contact\">\n        <div className=\"container contact-container\">\n          <h2 className=\"section-title\">Get in touch</h2>\n          <p className=\"contact-text\">\n            Currently open to new opportunities. Drop me a mail or connect on\n            LinkedIn.\n          </p>\n          <a href={`mailto:${data.meta.email}`} className=\"btn btn-primary\">\n            {data.meta.email}\n          </a>\n        </div>\n      </section>\n\n      <footer className=\"footer\">\n        <p>Vyshnav K S &mdash; {new Date().getFullYear()}</p>\n      </footer>\n    </div>\n  );\n}\n\nexport default App;\n","const reportWebVitals = onPerfEntry => {\n  if (onPerfEntry && onPerfEntry instanceof Function) {\n    import('web-vitals').then(({ getCLS, getFID, getFCP, getLCP, getTTFB }) => {\n      getCLS(onPerfEntry);\n      getFID(onPerfEntry);\n      getFCP(onPerfEntry);\n      getLCP(onPerfEntry);\n      getTTFB(onPerfEntry);\n    });\n  }\n};\n\nexport default reportWebVitals;\n","import React from \"react\";\nimport ReactDOM from \"react-dom\";\nimport \"./index.css\";\nimport App from \"./App\";\nimport reportWebVitals from \"./reportWebVitals\";\n\nReactDOM.render(<App />, document.getElementById(\"root\"));\n\n// If you want to start measuring performance in your app, pass a function\n// to log results (for example: reportWebVitals(console.log))\n// or send to an analytics endpoint. Learn more: https://bit.ly/CRA-vitals\nreportWebVitals();\n"]}}